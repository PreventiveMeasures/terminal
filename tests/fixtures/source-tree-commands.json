    "purpose": "Inventory every file",
    "command": "find . -type f -print | sort"
  },
  {
    "id": 5,
    "purpose": "Inventory JavaScript and TypeScript sources and tests",
    "command": "find src tests -type f \\( -name '*.js' -o -name '*.ts' \\) -print | sort"
  },
  {
    "id": 6,
    "purpose": "Inventory files while pruning dependencies",
    "command": "find . -type d -name node_modules -prune -o -type f -print | sort"
  },
  {
    "id": 7,
    "purpose": "Find empty source files",
    "command": "find src -type f -empty -print | sort"
  },
  {
    "id": 8,
    "purpose": "Rank JavaScript files by line count",
    "command": "find src -type f -name '*.js' -exec wc -l {} + | sort -nr"
  },
  {
    "id": 9,
    "purpose": "Measure JavaScript file sizes with NUL-safe filenames",
    "command": "find src -type f -name '*.js' -print0 | sort -z | xargs -0 -r wc -c"
  },
  {
    "id": 10,
    "purpose": "Read package metadata",
    "command": "cat package.json"
  },
  {
    "id": 11,
    "purpose": "Read the entry point header",
    "command": "head -n 40 src/index.js"
  },
  {
