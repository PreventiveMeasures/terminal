# Shell constructs the Oils bash spec suite exercises, written as one-line
# cases. Answers are bash 5.2.21's in the C locale. A construct this project
# does not implement is refused with a diagnostic rather than approximated,
# and those refusals are cases too — they are what keeps a gap visible.

# parameter expansion
echo ${u:-fallback} => "fallback\n"
v=set; echo ${v:-fallback} => "set\n"
echo ${u-fallback} => "fallback\n"
v=; echo ${v-fallback} => "\n"
v=set; echo ${v:+yes} => "yes\n"
echo ${u:+yes} => "\n"
v=; echo ${v:+yes} => "\n"
v=; echo ${v+yes} => "yes\n"
echo ${#u} => "0\n"
v=abcd; echo ${#v} => "4\n"
v=abcd; echo ${v#a} => "bcd\n"
v=abcd; echo ${v#x} => "abcd\n"
v=a.b.c; echo ${v#*.} => "b.c\n"
v=a.b.c; echo ${v##*.} => "c\n"
v=a.b.c; echo ${v%.*} => "a.b\n"
v=a.b.c; echo ${v%%.*} => "a\n"
v=abcd; echo ${v:1} => "bcd\n"
v=abcd; echo ${v:1:2} => "bc\n"
v=abcd; echo ${v:0:0} => "\n"
v=abcd; echo ${v: -2} => "cd\n"
v=abcd; echo ${v/b/X} => "aXcd\n"
v=abab; echo ${v//b/X} => "aXaX\n"
v=abab; echo ${v/#a/X} => "Xbab\n"
v=abab; echo ${v/%b/X} => "abaX\n"
v=abab; echo ${v//b} => "aa\n"
v=abcd; echo ${v/[bc]/X} => "aXcd\n"
echo ${1:-none} => "none\n"
"echo \"${@}\"" => "\n"
echo ${u:=assigned}${u} => "assignedassigned\n"
"v=abcd; echo \"${v}s\"" => "abcds\n"
v=abcd; echo ${v}s => "abcds\n"
echo ${u}empty => "empty\n" 0 +$u
echo $$ => ! $$ 1
echo $! => ! $! 1
echo $0 => ! $0 1
echo $- => ! $- 1
echo $_ => ! $_ 1
"echo \"pre$$post\"" => ! $$ 1
echo ${$:-fallback} => ! $$ 1
echo $$; echo after => ! $$ 0 "after\n"
"echo \"pre$_post\"" => "pre\n" 0 +$_post
v=abcd; echo ${v^^} => ! ${ 1
v=ABCD; echo ${v,,} => ! ${ 1
v=abcd; echo ${v@Q} => ! ${ 1
u=v; v=x; echo ${!u} => ! ${ 1
a=(1 2); echo ${a[@]} => ! ${ 1
echo ${#a[@]} => ! ${ 1
echo ${@:1:2} => ! ${ 1

# arithmetic expansion
echo $(( 1 + 2 )) => "3\n"
echo $(( 2 * 3 + 4 )) => "10\n"
echo $(( (2 + 3) * 4 )) => "20\n"
echo $(( 7 / 2 )) => "3\n"
echo $(( 7 % 3 )) => "1\n"
echo $(( 2 ** 8 )) => "256\n"
echo $(( -3 + 1 )) => "-2\n"
echo $(( 1 < 2 )) => "1\n"
echo $(( 1 > 2 )) => "0\n"
echo $(( 1 == 1 )) => "1\n"
echo $(( 1 != 1 )) => "0\n"
echo $(( 1 && 0 )) => "0\n"
echo $(( 1 || 0 )) => "1\n"
echo $(( ! 0 )) => "1\n"
echo $(( 1 ? 20 : 30 )) => "20\n"
echo $(( 0 ? 20 : 30 )) => "30\n"
n=5; echo $(( n + 1 )) => "6\n"
n=5; echo $(( $n * 2 )) => "10\n"
echo $(( 0x10 )) => "16\n"
echo $(( 010 )) => "8\n"
echo $(( 1 << 4 )) => "16\n"
echo $(( 256 >> 4 )) => "16\n"
echo $(( 6 & 3 )) => "2\n"
echo $(( 6 | 3 )) => "7\n"
echo $(( 6 ^ 3 )) => "5\n"
echo $((1+2))$((3+4)) => "37\n"
"echo \"$(( 1 + 1 ))\"" => "2\n"

# conditionals
[[ a == a ]] && echo yes || echo no => "yes\n"
[[ a == b ]] && echo yes || echo no => "no\n"
[[ a != b ]] && echo yes || echo no => "yes\n"
[[ abc == a* ]] && echo yes || echo no => "yes\n"
"[[ abc == \"a*\" ]] && echo yes || echo no" => "no\n"
"[[ -z \"\" ]] && echo yes || echo no" => "yes\n"
"[[ -n \"x\" ]] && echo yes || echo no" => "yes\n"
[[ 1 -lt 2 ]] && echo yes || echo no => "yes\n"
[[ 2 -le 2 ]] && echo yes || echo no => "yes\n"
[[ 3 -gt 2 ]] && echo yes || echo no => "yes\n"
[[ a < b ]] && echo yes || echo no => ! [[ < 0 "no\n"
[[ b > a ]] && echo yes || echo no => ! [[ > 0 "no\n"
[[ -f input ]] && echo yes || echo no => "yes\n"
[[ -d input ]] && echo yes || echo no => "no\n"
[[ -e nosuch ]] && echo yes || echo no => "no\n"
[[ a == a && b == b ]] && echo yes || echo no => "yes\n"
[[ a == a || b == c ]] && echo yes || echo no => "yes\n"
[[ ! a == b ]] && echo yes || echo no => "yes\n"
[[ ( a == a ) ]] && echo yes || echo no => "yes\n"
[ a = a ] && echo yes || echo no => "yes\n"
[ a != b ] && echo yes || echo no => "yes\n"
test -f input && echo yes || echo no => "yes\n"
"[ -z \"\" ] && echo yes || echo no" => "yes\n"
[ 1 -eq 1 ] && echo yes || echo no => "yes\n"
[[ abc =~ b ]] && echo yes || echo no => ! [[ =~ 1
[[ abc == @(a|b)* ]] && echo yes || echo no => ! [[ extglob 1

# `[[` opens a conditional wherever a command may start, and is an ordinary
# word everywhere else
if [[ -f input ]]; then echo yes; fi => "yes\n"
while [[ -f input ]]; do echo hit; break; done => "hit\n"
until [[ -f input ]]; do echo no; break; done; echo after => "after\n"
while ! [[ -f nosuch ]]; do echo once; break; done => "once\n"
while [[ -f input ]] && [[ -d nosuch ]]; do echo no; done; echo after => "after\n"
until { [[ -f input ]]; }; do echo no; break; done; echo after => "after\n"
{ [[ -f input ]]; } && echo yes || echo no => "yes\n"
( [[ -f input ]] ) && echo yes || echo no => "yes\n"
[[ -f input ]] && [[ -n x ]] && echo both => "both\n"
f() { [[ -f input ]]; }; f && echo yes || echo no => "yes\n"
f() { [[ -f nosuch ]]; }; f && echo yes || echo no => "no\n"
f() { [[ -f input ]] && echo yes; }; f => "yes\n"
f() { [[ -f input ]]; }; f | cat; echo $? => "0\n"
echo until [[ x ]] => "until [[ x ]]\n"
f() { [[ -f $x ]]; }; f => ! function 1
f() { [[ a == `x` ]]; }; f => ! function 1

# quoting and word splitting
"echo \"a  b\"" => "a  b\n"
echo 'a  b' => "a  b\n"
echo a  b => "a b\n"
"echo \"a'b\"" => "a'b\n"
"echo 'a\"b'" => "a\"b\n"
echo \$HOME => "$HOME\n"
"v=x; echo \"$v\"" => "x\n"
v=x; echo '$v' => "$v\n"
"v=\"a b\"; echo $v" => "a b\n"
"v=\"a b\"; echo \"$v\"" => "a b\n"
"echo \"$(echo nested)\"" => "nested\n"
echo $(echo nested) => "nested\n"
"echo \"a$(echo b)c\"" => "abc\n"
"v=x; echo ${v}\"y\"" => "xy\n"
"echo \"\"" => "\n"
"echo \"\" \"\"" => " \n"
"echo a\"b\"c" => "abc\n"
echo a'b'c => "abc\n"
"echo \"\\$v\"" => "$v\n"
"echo \"\\\\\"" => "\\\n"
"printf \"%s\\n\" \"a b\"" => "a b\n"
"printf \"%s|\" a b; echo" => "a|b|\n"

# control flow, pipelines and substitution
for i in a b c; do echo $i; done => "a\nb\nc\n"
for i in 1 2; do for j in x y; do echo $i$j; done; done => "1x\n1y\n2x\n2y\n"
if true; then echo yes; fi => "yes\n"
if false; then echo yes; else echo no; fi => "no\n"
if false; then echo a; elif true; then echo b; else echo c; fi => "b\n"
true && echo yes => "yes\n"
false || echo no => "no\n"
true; echo $? => "0\n"
false; echo $? => "1\n"
! true; echo $? => "1\n"
! false; echo $? => "0\n"
{ echo a; echo b; } => "a\nb\n"
( echo a; echo b ) => "a\nb\n"
echo a | cat => "a\n"
echo a | cat | cat => "a\n"
"echo one two | cut -d\" \" -f2" => "two\n"
v=$(echo captured); echo $v => "captured\n"
v=`echo backtick`; echo $v => "backtick\n"
for f in input; do cat $f; done => "oak\nelm\nfir\n"
if [ -f input ]; then echo present; fi => "present\n"
while true; do break; done => ""
x=0; while test $x -lt 3; do echo $x; x=$((x+1)); done => "0\n1\n2\n"
while false; do echo no; done; echo $? => "0\n"
until true; do echo no; done; echo $? => "0\n"
x=1; while test -n "$x"; do x=; false; done; echo $? => "1\n"
while echo tick; do break; done => "tick\n"
until test -e input; do echo waiting; done; echo $? => "0\n"
case a in a) echo yes;; esac => ! case 1
f() { echo hi; }; f => "hi\n"
f() { echo a; echo b; }; f | tr a-z A-Z => "A\nB\n"
g() { cat; }; echo z | g => "z\n"
f() { cat input; }; f; f => "oak\nelm\nfir\noak\nelm\nfir\n"
f() { echo hi; }; f arg1 arg2 => "hi\n"
f() { echo one; }; f; echo $? => "one\n0\n"
f() { echo $x; }; f => ! function 1
f() { i=0; }; f => ! function 1
f() { echo "$@"; }; f => ! function 1
"f() { cat <<EOF\n$HOME\nEOF\n}; f" => ! function 1
f() { echo hi; } > out => ! function 1
f() { f; }; f => ! function recursion 1
f() { echo x; }; if f; then echo then; fi => "x\nthen\n"
f() { echo one; echo two; }; f | head -1 => "one\n"
f() { cat; }; echo piped | f | tr a-z A-Z => "PIPED\n"
f() { cat input; }; f | wc -l => "3\n"
f() { echo x; }; for i in 1 2 3; do f; done | wc -l => "3\n"
f() { echo a; }; g() { echo b; }; f; g; f => "a\nb\na\n"
f() { echo in f; }; g() { f; f; }; g => "in f\nin f\n"
f() { true; }; f; echo $? => "0\n"
f() { false; }; f; echo $? => "1\n"
f() { grep nosuch input; }; f; echo $? => "1\n"
f() { printf a; printf b; }; f => "ab"
f() { echo done; }; { f; } | cat => "done\n"
f() { echo done; }; ( f ) => "done\n"
cd /; f() { pwd; }; f => "/\n"
f() { break; }; for i in a b; do f; echo $i; done => "a\nb\n" 0 %
(g() { echo in; }); g => ! g 127
f() { echo hi; } | cat; f => ! f 127
i=0; while test $i -lt 3; do j=0; while test $j -lt 2; do echo $i$j; j=$((j+1)); done; i=$((i+1)); done => "00\n01\n10\n11\n20\n21\n"
i=0; while test $i -lt 5; do i=$((i+1)); if test $i -eq 3; then break; fi; echo $i; done => "1\n2\n"
i=0; while test $i -lt 5; do i=$((i+1)); if test $i -eq 3; then continue; fi; echo $i; done => "1\n2\n4\n5\n"
for a in 1 2; do i=0; while test $i -lt 2; do i=$((i+1)); if test $i -eq 1; then continue 2; fi; echo miss; done; echo $a; done => ""
while echo a; echo b; false; do echo body; done => "a\nb\n"
while true; do echo x; break; done | wc -l => "1\n"
while false; do :; done | wc -l => "0\n"
while test 1 -eq 1; do break; done; echo after=$? => "after=0\n"
f() { echo a; }; while f; do break; done => "a\n"
f() { false; }; until f; do echo body; break; done => "body\n"
n=0; until [[ $n == 3 ]]; do n=$((n+1)); echo $n; done => "1\n2\n3\n"
until false; do echo x; break; done => "x\n"
f() { echo a; }; for i in 1 2; do f; done => "a\na\n"
f() { echo hi; }; g() { f; }; h() { g; }; h => "hi\n"
f() { echo a; }; g() { f; f; }; g | wc -l => "2\n"
for i in a b; do for j in c d; do echo $i$j; break; done; done => "ac\nbc\n"
for i in a b; do continue; echo no; done; echo after => "after\n"
for i in a b; do :; done; echo "[$i]" => "[b]\n"
for i in a; do echo $i; done; for i in b; do echo $i; done => "a\nb\n"
for i in a b; do echo $i; done > /dev/null; echo after => "after\n"
for f in input nosuch; do [[ -e $f ]] && echo "$f yes" || echo "$f no"; done => "input yes\nnosuch no\n"
while true; do while true; do break 2; done; echo no; done; echo after => "after\n"
while false; do echo x; done < input; echo after => "after\n"
until true; do echo x; done | wc -l => "0\n"
n=0; while [[ $n -lt 2 ]]; do n=$((n+1)); done; echo $n => "2\n"
n=0; while [[ $n -lt 3 ]]; do n=$((n+1)); [[ $n == 2 ]] && continue; echo $n; done => "1\n3\n"
echo a | { cat; cat; } => "a\n"
f() { echo hi; } echo bye => % 2
( ls ) ls => % 2
{ ls; } ls => % 2
while false; do ls; done ls => % 2
until false; do ls; done ls => % 2
echo 2>(cat) => ! >( 1
f() { echo hi; }; f > /dev/null; echo after => "after\n"
cat <(echo hi) => ! <( 1
diff <(echo a) <(echo b) => ! <( 1
echo x > >(cat) => ! >( 1
set -e => ! set 127
shopt -s nullglob => ! shopt 127
"trap \"echo bye\" EXIT" => ! trap 127

# backtick command substitution, which quotes differently from $( )
echo `echo hi` => "hi\n"
v=`echo hi`; echo $v => "hi\n"
"echo \"`echo hi`\"" => "hi\n"
echo a`echo b`c => "abc\n"
echo `echo a``echo b` => "ab\n"
grep `echo oak` input => "oak\n"
"for i in `echo a b`; do echo \"<$i>\"; done" => "<a>\n<b>\n"
echo `cat input` => "oak elm fir\n"
"echo \"`cat input`\"" => "oak\nelm\nfir\n"
echo `echo a; echo b` => "a b\n"
"echo `echo one two | cut -d\" \" -f2`" => "two\n"
echo $(echo `echo nested-in-dollar`) => "nested-in-dollar\n"
echo `echo $(echo dollar-in-backtick)` => "dollar-in-backtick\n"
if `true`; then echo yes; fi => "yes\n"
echo `false`; echo $? => "\n0\n"
echo `echo` => "\n"
"echo \"before `echo mid` after\"" => "before mid after\n"
"echo `echo \"quoted inside\"`" => "quoted inside\n"
echo `echo 'single inside'` => "single inside\n"
"echo `printf \"a b  c\"`" => "a b c\n"
"echo \"`printf \"a b  c\"`\"" => "a b  c\n"
echo `echo \$HOME` => "/\n"
echo `echo \\` => "\\\n"
echo `echo \n` => "n\n"
echo `echo \\n` => "n\n"
"echo \"`echo \\$HOME`\"" => "/\n"
echo '`echo hi`' => "`echo hi`\n"
echo \`echo hi\` => "`echo hi`\n"
echo '`' => "`\n"
"cat <<EOF\n`echo hi`\nEOF" => "hi\n"
"cat <<'EOF'\n`echo hi`\nEOF" => "`echo hi`\n"
"cat <<EOF\nbefore `echo mid` after\nEOF" => "before mid after\n"
[[ `echo a` == a ]] && echo yes || echo no => "yes\n"
[[ -n `echo x` ]] && echo yes || echo no => "yes\n"
echo `echo \`nested\`` => ! \` 1
echo `if true` => "\n" 0 %
echo `for` => "\n" 0 %
echo `echo )` => "\n" 0 %
"`if true`; echo \"status=$?\"" => "status=2\n" 0 %
echo pre`if true`post => "prepost\n" 0 %
echo `if true` `echo ok` => "ok\n" 0 %
echo ${x:-`echo d`} => ! ` 1
echo $(( `echo 2` + 1 )) => ! ` 1

# writing to a read-only mount is refused, never half-applied
echo made > out => ! > 1
echo made >> out => ! >> 1
echo made 2> err => ! 2> 1
sed -i s/oak/pine/ input => ! -i 1
sed 's/oak/pine/w out' input => ! output file 1
sed -n '/elm/w out' input => ! output file 1
cat input > copy => ! > 1
cp input copy => % 1
rm input => % 1
