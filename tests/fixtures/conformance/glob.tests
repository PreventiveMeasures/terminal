# Pathname expansion and the matcher behind it, checked against bash 5.2.21
# in the C locale. glob-audit.test.js covers compileGlob directly; these cases
# drive the same engine through the doors a caller uses — expansion, [[ == ]],
# find -name and the ${x#pat} family — because a matcher can be right in one
# and wrong in the next.

@tree glob
# pathname expansion
echo * => "1 10 2 A.txt B a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc b.txt dir\n"
"ls -d * 2>/dev/null; echo \"exit=$?\"" => "1\n10\n2\nA.txt\nB\na\na b\na*b\na-b\na.b.c\na.txt\na?b\na]b\nab\nab.txt\nabc\nb.txt\ndir\nexit=0\n"
echo *.txt => "A.txt a.txt ab.txt b.txt\n"
"ls -d *.txt 2>/dev/null; echo \"exit=$?\"" => "A.txt\na.txt\nab.txt\nb.txt\nexit=0\n"
echo a* => "a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc\n"
"ls -d a* 2>/dev/null; echo \"exit=$?\"" => "a\na b\na*b\na-b\na.b.c\na.txt\na?b\na]b\nab\nab.txt\nabc\nexit=0\n"
echo *b* => "a b a*b a-b a.b.c a?b a]b ab ab.txt abc b.txt\n"
"ls -d *b* 2>/dev/null; echo \"exit=$?\"" => "a b\na*b\na-b\na.b.c\na?b\na]b\nab\nab.txt\nabc\nb.txt\nexit=0\n"
echo ? => "1 2 B a\n"
"ls -d ? 2>/dev/null; echo \"exit=$?\"" => "1\n2\nB\na\nexit=0\n"
echo ?? => "10 ab\n"
"ls -d ?? 2>/dev/null; echo \"exit=$?\"" => "10\nab\nexit=0\n"
echo a? => "ab\n"
"ls -d a? 2>/dev/null; echo \"exit=$?\"" => "ab\nexit=0\n"
echo *.* => "A.txt a.b.c a.txt ab.txt b.txt\n"
"ls -d *.* 2>/dev/null; echo \"exit=$?\"" => "A.txt\na.b.c\na.txt\nab.txt\nb.txt\nexit=0\n"
echo [ab] => "a\n"
"ls -d [ab] 2>/dev/null; echo \"exit=$?\"" => "a\nexit=0\n"
echo [ab]* => "a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc b.txt\n"
"ls -d [ab]* 2>/dev/null; echo \"exit=$?\"" => "a\na b\na*b\na-b\na.b.c\na.txt\na?b\na]b\nab\nab.txt\nabc\nb.txt\nexit=0\n"
echo [!a]* => "1 10 2 A.txt B b.txt dir\n"
"ls -d [!a]* 2>/dev/null; echo \"exit=$?\"" => "1\n10\n2\nA.txt\nB\nb.txt\ndir\nexit=0\n"
echo [^a]* => "1 10 2 A.txt B b.txt dir\n"
"ls -d [^a]* 2>/dev/null; echo \"exit=$?\"" => "1\n10\n2\nA.txt\nB\nb.txt\ndir\nexit=0\n"
echo [a-c]* => "a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc b.txt\n"
"ls -d [a-c]* 2>/dev/null; echo \"exit=$?\"" => "a\na b\na*b\na-b\na.b.c\na.txt\na?b\na]b\nab\nab.txt\nabc\nb.txt\nexit=0\n"
echo [!a-c]* => "1 10 2 A.txt B dir\n"
"ls -d [!a-c]* 2>/dev/null; echo \"exit=$?\"" => "1\n10\n2\nA.txt\nB\ndir\nexit=0\n"
echo [[:digit:]] => "1 2\n"
"ls -d [[:digit:]] 2>/dev/null; echo \"exit=$?\"" => "1\n2\nexit=0\n"
echo [[:digit:]]* => "1 10 2\n"
"ls -d [[:digit:]]* 2>/dev/null; echo \"exit=$?\"" => "1\n10\n2\nexit=0\n"
echo [[:alpha:]][[:alpha:]] => "ab\n"
"ls -d [[:alpha:]][[:alpha:]] 2>/dev/null; echo \"exit=$?\"" => "ab\nexit=0\n"
echo []] => "[]]\n"
"ls -d []] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [a-] => "a\n"
"ls -d [a-] 2>/dev/null; echo \"exit=$?\"" => "a\nexit=0\n"
echo [-a] => "a\n"
"ls -d [-a] 2>/dev/null; echo \"exit=$?\"" => "a\nexit=0\n"
echo []a] => "a\n"
"ls -d []a] 2>/dev/null; echo \"exit=$?\"" => "a\nexit=0\n"
echo a[]]b => "a]b\n"
"ls -d a[]]b 2>/dev/null; echo \"exit=$?\"" => "a]b\nexit=0\n"
echo [A-Za-z] => "B a\n"
"ls -d [A-Za-z] 2>/dev/null; echo \"exit=$?\"" => "B\na\nexit=0\n"
echo [0-9][0-9] => "10\n"
"ls -d [0-9][0-9] 2>/dev/null; echo \"exit=$?\"" => "10\nexit=0\n"
echo .* => ".dotdir .h2 .hidden\n"
"ls -d .* 2>/dev/null; echo \"exit=$?\"" => ".dotdir\n.h2\n.hidden\nexit=0\n"
echo .[!.]* => ".dotdir .h2 .hidden\n"
"ls -d .[!.]* 2>/dev/null; echo \"exit=$?\"" => ".dotdir\n.h2\n.hidden\nexit=0\n"
echo *hidden* => "*hidden*\n"
"ls -d *hidden* 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo ?hidden => "?hidden\n"
"ls -d ?hidden 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [.]hidden => "[.]hidden\n"
"ls -d [.]hidden 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo dir/* => "dir/sub dir/x.txt dir/y\n"
"ls -d dir/* 2>/dev/null; echo \"exit=$?\"" => "dir/sub\ndir/x.txt\ndir/y\nexit=0\n"
echo dir/*.txt => "dir/x.txt\n"
"ls -d dir/*.txt 2>/dev/null; echo \"exit=$?\"" => "dir/x.txt\nexit=0\n"
echo */* => "dir/sub dir/x.txt dir/y\n"
"ls -d */* 2>/dev/null; echo \"exit=$?\"" => "dir/sub\ndir/x.txt\ndir/y\nexit=0\n"
echo */*/* => "dir/sub/z.txt\n"
"ls -d */*/* 2>/dev/null; echo \"exit=$?\"" => "dir/sub/z.txt\nexit=0\n"
echo */ => "dir/\n"
"ls -d */ 2>/dev/null; echo \"exit=$?\"" => "dir/\nexit=0\n"
echo *x* => "A.txt a.txt ab.txt b.txt\n"
"ls -d *x* 2>/dev/null; echo \"exit=$?\"" => "A.txt\na.txt\nab.txt\nb.txt\nexit=0\n"
echo d?r/* => "dir/sub dir/x.txt dir/y\n"
"ls -d d?r/* 2>/dev/null; echo \"exit=$?\"" => "dir/sub\ndir/x.txt\ndir/y\nexit=0\n"
echo ** => "1 10 2 A.txt B a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc b.txt dir\n"
"ls -d ** 2>/dev/null; echo \"exit=$?\"" => "1\n10\n2\nA.txt\nB\na\na b\na*b\na-b\na.b.c\na.txt\na?b\na]b\nab\nab.txt\nabc\nb.txt\ndir\nexit=0\n"
echo **/* => "dir/sub dir/x.txt dir/y\n"
"ls -d **/* 2>/dev/null; echo \"exit=$?\"" => "dir/sub\ndir/x.txt\ndir/y\nexit=0\n"
echo dir/** => "dir/sub dir/x.txt dir/y\n"
"ls -d dir/** 2>/dev/null; echo \"exit=$?\"" => "dir/sub\ndir/x.txt\ndir/y\nexit=0\n"
echo a\*b => "a*b\n"
"ls -d a\\*b 2>/dev/null; echo \"exit=$?\"" => "a*b\nexit=0\n"
echo a\?b => "a?b\n"
"ls -d a\\?b 2>/dev/null; echo \"exit=$?\"" => "a?b\nexit=0\n"
echo a[*]b => "a*b\n"
"ls -d a[*]b 2>/dev/null; echo \"exit=$?\"" => "a*b\nexit=0\n"
echo a[?]b => "a?b\n"
"ls -d a[?]b 2>/dev/null; echo \"exit=$?\"" => "a?b\nexit=0\n"
"echo \"a*b\"" => "a*b\n"
"ls -d \"a*b\" 2>/dev/null; echo \"exit=$?\"" => "a*b\nexit=0\n"
echo 'a*b' => "a*b\n"
"ls -d 'a*b' 2>/dev/null; echo \"exit=$?\"" => "a*b\nexit=0\n"
echo zzz* => "zzz*\n"
"ls -d zzz* 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [z]* => "[z]*\n"
"ls -d [z]* 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo nosuch/* => "nosuch/*\n"
"ls -d nosuch/* 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [Aa]* => "A.txt a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc\n"
"ls -d [Aa]* 2>/dev/null; echo \"exit=$?\"" => "A.txt\na\na b\na*b\na-b\na.b.c\na.txt\na?b\na]b\nab\nab.txt\nabc\nexit=0\n"
echo A* => "A.txt\n"
"ls -d A* 2>/dev/null; echo \"exit=$?\"" => "A.txt\nexit=0\n"
echo [a => "[a\n"
"ls -d [a 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [! => "[!\n"
"ls -d [! 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [] => "[]\n"
"ls -d [] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [!] => "[!]\n"
"ls -d [!] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [a- => "[a-\n"
"ls -d [a- 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo a[ => "a[\n"
"ls -d a[ 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [[:foo:]] => "[[:foo:]]\n"
"ls -d [[:foo:]] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [[:alpha] => "a\n"
"ls -d [[:alpha] 2>/dev/null; echo \"exit=$?\"" => "a\nexit=0\n"
echo [b-a] => "[b-a]\n"
"ls -d [b-a] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [/] => "[/]\n"
"ls -d [/] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo a[/]b => "a[/]b\n"
"ls -d a[/]b 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [\]] => "[]]\n"
"ls -d [\\]] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo [\*] => "[*]\n"
"ls -d [\\*] 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo ./* => "./1 ./10 ./2 ./A.txt ./B ./a ./a b ./a*b ./a-b ./a.b.c ./a.txt ./a?b ./a]b ./ab ./ab.txt ./abc ./b.txt ./dir\n"
"ls -d ./* 2>/dev/null; echo \"exit=$?\"" => "./1\n./10\n./2\n./A.txt\n./B\n./a\n./a b\n./a*b\n./a-b\n./a.b.c\n./a.txt\n./a?b\n./a]b\n./ab\n./ab.txt\n./abc\n./b.txt\n./dir\nexit=0\n"
echo ./a* => "./a ./a b ./a*b ./a-b ./a.b.c ./a.txt ./a?b ./a]b ./ab ./ab.txt ./abc\n"
"ls -d ./a* 2>/dev/null; echo \"exit=$?\"" => "./a\n./a b\n./a*b\n./a-b\n./a.b.c\n./a.txt\n./a?b\n./a]b\n./ab\n./ab.txt\n./abc\nexit=0\n"
echo dir/./x* => "dir/./x.txt\n"
"ls -d dir/./x* 2>/dev/null; echo \"exit=$?\"" => "dir/./x.txt\nexit=0\n"
echo dir/../a* => "dir/../a dir/../a b dir/../a*b dir/../a-b dir/../a.b.c dir/../a.txt dir/../a?b dir/../a]b dir/../ab dir/../ab.txt dir/../abc\n"
"ls -d dir/../a* 2>/dev/null; echo \"exit=$?\"" => "dir/../a\ndir/../a b\ndir/../a*b\ndir/../a-b\ndir/../a.b.c\ndir/../a.txt\ndir/../a?b\ndir/../a]b\ndir/../ab\ndir/../ab.txt\ndir/../abc\nexit=0\n"
echo dir//x* => "dir//x.txt\n"
"ls -d dir//x* 2>/dev/null; echo \"exit=$?\"" => "dir//x.txt\nexit=0\n"
echo dir/ => "dir/\n"
"ls -d dir/ 2>/dev/null; echo \"exit=$?\"" => "dir/\nexit=0\n"
echo */sub => "dir/sub\n"
"ls -d */sub 2>/dev/null; echo \"exit=$?\"" => "dir/sub\nexit=0\n"
echo */sub/* => "dir/sub/z.txt\n"
"ls -d */sub/* 2>/dev/null; echo \"exit=$?\"" => "dir/sub/z.txt\nexit=0\n"
"echo \"a\"*" => "a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc\n"
"ls -d \"a\"* 2>/dev/null; echo \"exit=$?\"" => "a\na b\na*b\na-b\na.b.c\na.txt\na?b\na]b\nab\nab.txt\nabc\nexit=0\n"
"echo a\"*\"" => "a*\n"
"ls -d a\"*\" 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo a'*'b => "a*b\n"
"ls -d a'*'b 2>/dev/null; echo \"exit=$?\"" => "a*b\nexit=0\n"
"echo *\"txt\"" => "A.txt a.txt ab.txt b.txt\n"
"ls -d *\"txt\" 2>/dev/null; echo \"exit=$?\"" => "A.txt\na.txt\nab.txt\nb.txt\nexit=0\n"
"echo \"*\".txt" => "*.txt\n"
"ls -d \"*\".txt 2>/dev/null; echo \"exit=$?\"" => "exit=2\n"
echo a\-b => "a-b\n"
"ls -d a\\-b 2>/dev/null; echo \"exit=$?\"" => "a-b\nexit=0\n"

# the matcher behind [[ ]], find and ${x#pat}
[[ abc == a* ]] && echo yes || echo no => "yes\n"
[[ abc == *c ]] && echo yes || echo no => "yes\n"
[[ abc == a?c ]] && echo yes || echo no => "yes\n"
[[ abc == ab ]] && echo yes || echo no => "no\n"
[[ abc == [a-c][a-c][a-c] ]] && echo yes || echo no => "yes\n"
[[ abc == [!x]bc ]] && echo yes || echo no => "yes\n"
[[ a/b == a*b ]] && echo yes || echo no => "yes\n"
[[ a/b == a?b ]] && echo yes || echo no => "yes\n"
[[ .x == * ]] && echo yes || echo no => "yes\n"
"[[ \"a*b\" == a\\*b ]] && echo yes || echo no" => "yes\n"
"[[ \"a*b\" == a[*]b ]] && echo yes || echo no" => "yes\n"
"[[ \"a]b\" == a[]]b ]] && echo yes || echo no" => "yes\n"
[[ a-b == a[-]b ]] && echo yes || echo no => "yes\n"
[[ a1c == a[[:digit:]]c ]] && echo yes || echo no => "yes\n"
[[ abc == a[[:digit:]]c ]] && echo yes || echo no => "no\n"
"[[ \"\" == * ]] && echo yes || echo no" => "yes\n"
"[[ \"\" == ? ]] && echo yes || echo no" => "no\n"
[[ abc == *a*b*c* ]] && echo yes || echo no => "yes\n"
[[ abc == ** ]] && echo yes || echo no => "yes\n"
"[[ abc == \"a*\" ]] && echo yes || echo no" => "no\n"
"[[ \"a*\" == \"a*\" ]] && echo yes || echo no" => "yes\n"
[[ abc != a* ]] && echo yes || echo no => "no\n"
"p=\"a*\"; echo $p" => "a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc\n"
"p=\"a*\"; echo \"$p\"" => "a*\n"
"p=\"a*\"; echo ${p}" => "a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc\n"
"p=\"*.txt\"; for f in $p; do echo \"<$f>\"; done" => "<A.txt>\n<a.txt>\n<ab.txt>\n<b.txt>\n"
"p=\"a*\"; [[ abc == $p ]] && echo yes || echo no" => "yes\n"
"p=\"a*\"; [[ abc == \"$p\" ]] && echo yes || echo no" => "no\n"
"v=abc; p=\"a*\"; echo \"${v#$p}\"" => "bc\n"
find . -name 'a*' | sort => "./a\n./a b\n./a*b\n./a-b\n./a.b.c\n./a.txt\n./a?b\n./a]b\n./ab\n./ab.txt\n./abc\n"
find . -name '*.txt' | sort => "./A.txt\n./a.txt\n./ab.txt\n./b.txt\n./dir/sub/z.txt\n./dir/x.txt\n"
find . -name 'a?b' | sort => "./a b\n./a*b\n./a-b\n./a?b\n./a]b\n"
find . -name '[ab]' | sort => "./a\n"
find . -name '[!a]' | sort => ".\n./1\n./2\n./B\n./dir/y\n"
find . -name 'a[]]b' | sort => "./a]b\n"
find . -name 'a\*b' | sort => "./a*b\n"
find . -name '*/x.txt' | sort => ""
find . -path '*/dir/*' | sort => "./dir/sub\n./dir/sub/z.txt\n./dir/x.txt\n./dir/y\n"
"v=a.b.c; echo \"${v#a}\"" => ".b.c\n"
"v=a.b.c; echo \"${v##*.}\"" => "c\n"
"v=a.b.c; echo \"${v#*.}\"" => "b.c\n"
"v=a.b.c; echo \"${v%.*}\"" => "a.b\n"
"v=a.b.c; echo \"${v%%.*}\"" => "a\n"
"v=a.b.c; echo \"${v#[ab]}\"" => ".b.c\n"
"v=a.b.c; echo \"${v#?}\"" => ".b.c\n"
"v=a.b.c; echo \"${v#*}\"" => "a.b.c\n"
"v=a.b.c; echo \"${v##*}\"" => "\n"
"v=a.b.c; echo \"${v#[!a]}\"" => "a.b.c\n"
"v=a.b.c; echo \"${v/[abc]/X}\"" => "X.b.c\n"
"v=a.b.c; echo \"${v//[.]/-}\"" => "a-b-c\n"
"v=a.b.c; echo \"${v/#a/X}\"" => "X.b.c\n"
"v=a.b.c; echo \"${v/%c/X}\"" => "a.b.X\n"
"v='a*b'; echo \"${v#[*]}\"" => "a*b\n"
"v='a*b'; echo \"${v#a\\*}\"" => "b\n"
cat *.txt => "7\n4\n5\n6\n"
wc -l *.txt => "1 A.txt\n1 a.txt\n1 ab.txt\n1 b.txt\n4 total\n"
ls dir/* => "dir/x.txt\ndir/y\n\ndir/sub:\nz.txt\n"
grep -l 4 *.txt => "a.txt\n"
head -n 1 a*.txt => "==> a.txt <==\n4\n\n==> ab.txt <==\n5\n"
"cat nosuch* 2>/dev/null; echo \"exit=$?\"" => "exit=1\n"
echo * => "1 10 2 A.txt B a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc b.txt dir\n"
echo [ab]* => "a a b a*b a-b a.b.c a.txt a?b a]b ab ab.txt abc b.txt\n"
"for f in *; do echo \"<$f>\"; done" => "<1>\n<10>\n<2>\n<A.txt>\n<B>\n<a>\n<a b>\n<a*b>\n<a-b>\n<a.b.c>\n<a.txt>\n<a?b>\n<a]b>\n<ab>\n<ab.txt>\n<abc>\n<b.txt>\n<dir>\n"

@tree wide
# matching that would need a locale is refused, not guessed
echo ? => ! non-ASCII glob matching 1
echo ?? => ! non-ASCII glob matching 1
echo a?b => ! non-ASCII glob matching 1
echo na?ve => ! non-ASCII glob matching 1
echo [μ] => ! non-ASCII glob matching 1
echo [ab]* => ! non-ASCII glob matching 1
echo * => "a a b a*b ab aμb b.txt naïve μ\n"

@tree glob
# collating symbols and equivalence classes are refused
echo [[.a.]] => ! glob collating or equivalence class 1
echo [[=a=]] => ! glob collating or equivalence class 1

@tree long
# a run of stars stays linear: each used to compile to its own `.*`, so
# n adjacent stars gave the backtracking matcher `(.*){n}` to explore. Against
# one 30-character name, 8 stars took 411ms and 12 took 123 seconds
echo ****************b => ~ 1000
ls ****************b 2>/dev/null; echo done => ~ 1000
cat ****************b 2>/dev/null; echo done => ~ 1000
find . -name '****************b' => ~ 1000
[[ aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa == ****************b ]] && echo yes || echo no => ~ 1000
"v=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa; echo \"${v#****************b}\"" => ~ 1000
"for f in ****************b; do echo \"<$f>\"; done" => ~ 1000
echo *.txt => "*.txt\n"
echo **.txt => "**.txt\n"
echo ****.txt => "****.txt\n"
