diff -rN e1 e2 => "diff -rN e1/x/f e2/x/f\n1d0\n< a\n" 1
diff -N e1 e2 => "Common subdirectories: e1/x and e2/x\n"
diff -r f1 f2 => "diff -r f1/a f2/a\n1c1\n< a\n---\n> b\n" 1
diff -rs f1 f1; echo $? => "0\n"
diff -r d1 d1; echo $? => "0\n"
diff -ru -L left -L right f1 f2 => "diff -ru -L left -L right left right\n--- left\n+++ right\n@@ -1 +1 @@\n-a\n+b\n" 1
diff -rq -L left -L right f1 f2 => "Files left and right differ\n" 1
diff -r -p d1 d2 | head -4 => "diff -r -p d1/.hidden d2/.hidden\n*** d1/.hidden\n--- d2/.hidden\n***************\n"
diff -r -a d1 d2 | head -6 => "diff -r -a d1/.hidden d2/.hidden\n1c1\n< .h1\n---\n> .h2\ndiff -r -a d1/Zed d2/Zed\n"
diff -r d1 d2 2>/dev/null | wc -l => "38\n"
