diff -r d1 d2 => "diff -r d1/.hidden d2/.hidden\n1c1\n< .h1\n---\n> .h2\ndiff -r d1/Zed d2/Zed\n1c1\n< Z\n---\n> Z2\nBinary files d1/bin and d2/bin differ\ndiff -r d1/diff d2/diff\n1c1\n< one\n---\n> two\nFile d1/fd is a regular file while file d2/fd is a directory\nOnly in d1: only-in-1\nOnly in d2: only-in-2\nOnly in d1: only1\nOnly in d2: only2\ndiff -r \"d1/sp ace\" \"d2/sp ace\"\n1c1\n< u\n---\n> v\ndiff -r d1/sub/deep/x d2/sub/deep/x\n1c1\n< deep1\n---\n> deep2\ndiff -r d1/sub/f d2/sub/f\n1c1\n< a\n---\n> b\nOnly in d1/sub: only-sub-1\nOnly in d2/sub: only-sub-2\n" 1
diff -ru d1 d2 => "diff -ru d1/.hidden d2/.hidden\n--- d1/.hidden\n+++ d2/.hidden\n@@ -1 +1 @@\n-.h1\n+.h2\ndiff -ru d1/Zed d2/Zed\n--- d1/Zed\n+++ d2/Zed\n@@ -1 +1 @@\n-Z\n+Z2\nBinary files d1/bin and d2/bin differ\ndiff -ru d1/diff d2/diff\n--- d1/diff\n+++ d2/diff\n@@ -1 +1 @@\n-one\n+two\nFile d1/fd is a regular file while file d2/fd is a directory\nOnly in d1: only-in-1\nOnly in d2: only-in-2\nOnly in d1: only1\nOnly in d2: only2\ndiff -ru \"d1/sp ace\" \"d2/sp ace\"\n--- \"d1/sp ace\"\n+++ \"d2/sp ace\"\n@@ -1 +1 @@\n-u\n+v\ndiff -ru d1/sub/deep/x d2/sub/deep/x\n--- d1/sub/deep/x\n+++ d2/sub/deep/x\n@@ -1 +1 @@\n-deep1\n+deep2\ndiff -ru d1/sub/f d2/sub/f\n--- d1/sub/f\n+++ d2/sub/f\n@@ -1 +1 @@\n-a\n+b\nOnly in d1/sub: only-sub-1\nOnly in d2/sub: only-sub-2\n" 1
