# Text past ASCII in the C.UTF-8 locale, answered by GNU grep 3.11 and GNU
# sed 4.9 in that locale and recorded by record-utf8.mjs: case folding, the
# named classes, words and spaces, all read from glibc's own tables. The
# refusals at the end are this implementation's and were written by hand.
# Recorded from: grep (GNU grep) 3.11; sed (GNU sed) 4.9.

@tree accents
grep -i é one => "é\n"
grep -i É one => "é\n"
grep -ic café cafe => "3\n"
grep -i CAFÉ cafe => "café\nCAFÉ\nCafé\n"
grep -iF café cafe => "café\nCAFÉ\nCafé\n"
grep -ix café cafe => "café\nCAFÉ\nCafé\n"
grep -iw café cafe => "café\nCAFÉ\nCafé\n"
grep -io É cafe => "é\nÉ\né\n"
grep -in caf. cafe => "1:café\n2:CAFÉ\n3:Café\n4:cafe\n"
grep -i '[é]' cafe => "café\nCAFÉ\nCafé\n"
grep -ic '[^é]' cafe => "4\n"
grep -iv café cafe => "cafe\n"
grep -i σ sigma => "Σ\nς\nσ\n"
grep -i ς sigma => "Σ\nς\nσ\n"
grep -i Σ sigma => "Σ\nς\nσ\n"
grep -i '[σ]' sigma => "Σ\nς\nσ\n"
grep -io σ sigma => "Σ\nς\nσ\n"
grep -ic Σ sigma => "3\n"
grep -i i si => "ı\ni\nI\n"
grep -i I si => "ı\ni\nI\n"
grep -i ı si => "ı\ni\nI\n"
grep -i İ si => "İ\n"
grep -i s si => "ſ\nS\ns\n"
grep -i ſ si => "ſ\nS\ns\n"
grep -i k si => "k\nK\n"
grep -i K si => "k\nK\n"
grep -i K si => "K\n"
grep -iF ı si => "ı\ni\nI\n"
grep -i '[i]' si => "ı\ni\nI\n"
grep -ic '[^i]' si => "7\n"
grep -i '[a-z]' si => "ı\ni\nI\nſ\nS\ns\nk\nK\n"
grep -i '[[:lower:]]' si => "ı\nİ\ni\nI\nſ\nS\ns\nK\nk\nK\n"
grep -i '[[:upper:]]' si => "ı\nİ\ni\nI\nſ\nS\ns\nK\nk\nK\n"
grep -i ǅ dz => "ǅ\nǄ\nǆ\n"
grep -i ǆ dz => "ǅ\nǄ\nǆ\n"
grep -i Ǆ dz => "ǅ\nǄ\nǆ\n"
grep -i ι iota => "ͅ\nΙ\nι\nι\n"
grep -i Ι iota => "ͅ\nΙ\nι\nι\n"
grep -ic ͅ iota => "4\n"
grep -i ι iota => "ͅ\nΙ\nι\nι\n"
grep -i µ micro => "µ\nμ\nΜ\n"
grep -i μ micro => "µ\nμ\nΜ\n"
grep -i Μ micro => "µ\nμ\nΜ\n"
grep -i '[!-~]' micro => "" 1
grep -i '[!-~]' si => "ı\ni\nI\nſ\nS\ns\nk\nK\n"
grep -i '[[:lower:]]' cjk => "日本語\n"
grep '[[:lower:]]' cjk => "" 1
grep '[[:alpha:]]' cjk => "日本語\n"
grep -i 日本 cjk => "日本語\n"
grep -i oak mixed => "oak\nOAK\nOak\n"
grep -ic OAK mixed => "3\n"
grep -io o.k mixed => "oak\nOAK\nOak\n"
grep -iw oak mixed => "oak\nOAK\nOak\n"
grep -ix Oak mixed => "oak\nOAK\nOak\n"
grep -i '[[:upper:]]' mixed => "oak\nOAK\nOak\n"
grep -i '[a-z]' mixed => "oak\nOAK\nOak\n"
grep -icE '(o)ak' mixed => "3\n"
grep -i '\(o\)\1' mixed => "" 1
grep -in 'k$' mixed => "1:oak\n2:OAK\n3:Oak\n"
grep -i '[A-z]' misc => "b\na\n"
grep '[A-z]' misc => "_\nb\na\n[\n`\n"
grep -i '[a-{]' misc => "_\n{\nb\na\n[\n`\n"
grep '[a-{]' misc => "{\nb\na\n"
grep -i '[[-{]' misc => "_\n{\n[\n`\n"
grep '[[-{]' misc => "_\n{\nb\na\n[\n`\n"
grep -i '[a-Z]' misc => "b\na\n"
grep '[a-Z]' misc => % 2
grep -i '[Z-a]' misc => % 2
grep '[Z-a]' misc => "_\na\n[\n`\n"
grep -i '[!-~]' misc => "_\n{\nb\na\n[\n`\n"
grep '[à-ÿ]' one => % 2
grep -i '[à-ÿ]' one => % 2
grep '[[.é.]]' one => % 2
grep '[[=é=]]' one => % 2
grep -w é words => "é\nfoo é bar\n"
grep -wc foo words => "1\n"
grep -w cafe words => "cafe\n"
grep -w a dot => "" 1
grep -w naïve words => "naïve\n"
grep '\bé' words => "é\nfoo é bar\n"
grep 'é\b' words => "é\nfoo é bar\n"
grep -c '\<é\>' words => "2\n"
grep -o '\w*' one => "é\n"
grep -o '\w\+' words => "é\nfoo\né\nbar\ncafé_x\nΣ\nnaïve\ncafe\n"
grep -c '\W' words => "1\n"
grep -E '\bfoo\b' words => "foo é bar\n"
grep -o 'ca\B.' words => "caf\ncaf\n"
grep -o '[[:alnum:]_]*' words => "é\nfoo\né\nbar\ncafé_x\nΣ\nnaïve\ncafe\n"
grep -c '^[[:alpha:]]*$' words => "4\n"
grep -on '[[:alpha:]]\+' words => "1:é\n2:foo\n2:é\n2:bar\n3:café\n3:x\n4:Σ\n5:naïve\n6:cafe\n"
grep -o '\w' cjk => "日\n本\n語\n"
grep -c '\b' cjk => "1\n"
grep -c '\<' one => "1\n"
grep -o '\b.' dot => "a\n"
grep -c '[[:space:]]' space => "2\n"
grep -c '\s' space => "2\n"
grep -o 'a\sb' space => "a b\na b\n"
grep -c '[[:blank:]]' space => "2\n"
grep -c 'a\Sb' space => "1\n"
grep -c '[[:punct:]]' words => "1\n"
grep -o '[[:print:]]*' one => "é\n"
grep -c '[[:graph:]]' space => "3\n"
grep -c '[[:cntrl:]]' space => "0\n" 1
grep -c '[[:alpha:]]' one => "1\n"
grep -x '[[:alpha:]]' one => "é\n"
grep -o '[[:alpha:]]' dot => "a\né\nb\n"
grep '^[[:alpha:]]$' one => "é\n"
grep -cE 'é{2}' one => "0\n" 1
grep -c 'é\{1\}' one => "1\n"
grep -cE '(é|x)+' dot => "1\n"
grep -c '[^é]' one => "0\n" 1
grep -o '[^a-z]' cafe => "é\nC\nA\nF\nÉ\nC\né\n"
grep -c '[[:upper:]]' sigma => "1\n"
grep -c '[[:lower:]]' sigma => "2\n"
grep -c '[[:alpha:]]' iota => "4\n"
grep -o '[[:digit:]]*' one => ""
grep в ve => "в\n"
grep -c ᲀ ve => "1\n"
sed 's/é/X/I' cafe => "cafX\nCAFX\nCafX\ncafe\n"
sed -n '/CAFÉ/Ip' cafe => "café\nCAFÉ\nCafé\n"
sed 's/[[:alpha:]]/x/' one => "x\n"
sed 's/[[:alpha:]]/X/g' words => "X\nXXX X XXX\nXXXX_X\nX\nXXXXX\nXXXX\n"
sed 's/[[:lower:]]/X/Ig' cafe => "XXXX\nXXXX\nXXXX\nXXXX\n"
sed 's/[[:upper:]]/X/Ig' cafe => "XXXX\nXXXX\nXXXX\nXXXX\n"
sed 's/σ/X/Ig' sigma => "X\nX\nX\n"
sed -n '/[[:upper:]]/p' sigma => "Σ\n"
sed -n '/[[:upper:]]/Ip' cjk => "日本語\n"
sed 's/\w/X/g' dot => "XXX\n"
sed 's/\bé/X/' words => "X\nfoo X bar\ncafé_x\nΣ\nnaïve\ncafe\n"
sed 's/\<caf\>/X/' words => "é\nfoo é bar\ncafé_x\nΣ\nnaïve\ncafe\n"
sed -n '/[A-z]/Ip' misc => "b\na\n"
sed -n '/[Z-a]/Ip' misc => % 1
sed -n '/[a-Z]/Ip' misc => "b\na\n"
sed 's/[à-ÿ]/X/' one => % 1
sed 's/\s/X/g' space => "aXb\na b\naXb\n"
sed 's/[[:space:]]/X/g' space => "aXb\na b\naXb\n"
sed 's/i/X/Ig' si => "X\nİ\nX\nX\nſ\nS\ns\nK\nk\nK\n"
sed 's/k/X/Ig' si => "ı\nİ\ni\nI\nſ\nS\ns\nK\nX\nX\n"
sed -E 's/(é)/[\1]/I' cafe => "caf[é]\nCAF[É]\nCaf[é]\ncafe\n"
sed 's/é/X/2I' words => "é\nfoo é bar\ncafé_x\nΣ\nnaïve\ncafe\n"
sed -n 's/[[:alpha:]]/X/2p' words => "fXo é bar\ncXfé_x\nnXïve\ncXfe\n"
sed -n '/[[:alpha:]]/p' cjk => "日本語\n"
sed 's/./X/Ig' sigma => "X\nX\nX\n"
sed -E 's/(a|ab)/[\1]/I' mixed => "o[a]k\nO[A]K\nO[a]k\n"
sed 's/oak/X/I' mixed => "X\nX\nX\n"
sed -n '/OAK/I!p' mixed => ""

grep -Pi é one => ! non-ASCII regex semantics 2
grep -P '\w' one => ! non-ASCII regex semantics 2
grep -i '\(é\)\1' one => ! non-ASCII regex semantics 2
grep -ic 'x\(a\)\1' one => ! non-ASCII regex semantics 2
grep -i в ve => ! locale-sensitive regex 2
grep -i ᲀ one => ! locale-sensitive regex 2
sed 's/в/X/I' ve => ! case folding of Cyrillic Extended-C letters 1
grep '[[.a.]]' one => ! regex collating or equivalence class 2
grep '[[=a=]]' one => ! regex collating or equivalence class 2
grep -wo 'caf.' words => ! -o regex extent 2
sed 's/\(o\)\1/X/I' mixed => ! regex backreferences 1
rg . one => ! non-ASCII matching 2
rg -i café cafe => ! non-ASCII matching 2
